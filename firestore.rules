rules_version = '2';

// 共有コード（16桁）を知っている人だけが、そのリストを読み書きできる。
// コードの一覧を取ることはできないので、他人のリストを探し当てることはできない。
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{code} {
      allow get: if request.auth != null;
      // 新しい共有リストは作れないようにしてある（公開URLを知った他人に、この Firebase を使われないため）。
      // 作り直すときだけ、一時的に下の行を if request.auth != null && code.size() == 16; に戻す
      allow create: if false;
      allow list, update, delete: if false;

      match /{coll}/{docId} {
        allow read, write: if request.auth != null
          && coll in ['lists', 'stores', 'items']
          && exists(/databases/$(database)/documents/households/$(code));
      }
    }
  }
}
